# 复制成 .env 后填入真实值；.env 不要提交到 git
# 用法（Git Bash）：  set -a && source .env && set +a

# 必填：JWT 签名密钥（随便一串 32 位以上随机字符，换环境必须换）
COPILOT_JWT_SECRET=change-me-to-a-random-32-chars-string

# 必填：演示账号口令（config.yaml 里 auth.demo_users 的所有账号共用这一个口令）
COPILOT_DEMO_PWD=Demo#2026

# 必填：本地模型地址（Ollama 默认 http://127.0.0.1:11434/v1；切 vLLM 只改这一行）
COPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
COPILOT_LLM_API_KEY=ollama

# 必填：Harness 知识库（课程平台控制台里取；没拿到就先填占位，/health 会提示缺失）
COPILOT_HARNESS_ENDPOINT=https://harness.example.com/api
COPILOT_HARNESS_API_KEY=fill-me
COPILOT_HARNESS_KB_ID=fill-me

# 可选：配置文件路径（默认项目根目录 config.yaml）
# COPILOT_CONFIG=./config.yaml
