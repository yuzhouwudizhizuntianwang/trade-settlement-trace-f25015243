# 操作系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 本地导出临时件（Word/PDF 中间产物不入库，正式交付见 export/）
export/~$*.docx
export/*.tmp
tmp/
*.log

# 敏感数据（本项目不存放任何客户真实数据）
data/private/
*.csv.bak

# ---- 结算复核助手（src/copilot）----
# 本地环境变量（含密钥），禁止入库
src/copilot/.env
# 本地 SQLite，由 seed 自动生成
src/copilot/data/app.db
src/copilot/.verify.log
src/copilot/data/review.json
src/copilot/data/audit.jsonl
src/copilot/**/__pycache__/
